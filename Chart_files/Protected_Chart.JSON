{
"$schema": "https://vega.github.io/schema/vega-lite/v5.json",
"title": { 
    "text": "Countries Protecting The Most Area",
    "font":"Cantata One",
    "fontSize":28,
    "offset":20
 },
"width":1000,
"height":500,
"data": {
"url": "https://raw.githubusercontent.com/mkoi2/FIT3179Assignment2/main/Data_files/Protected.csv"
},
"layer":[{
    "mark": {"type":"bar","color":"green","height":8},
        "encoding": {
        "y": { "field": "Country", "type": "nominal" ,"title":null,"sort":{"order":"descending"}},
        "x": { "field": "Area", "type": "quantitative" ,"title":"Total Protected Area (km^2)"},
        "opacity":{"value":1},
        "tooltip":[
            { "field": "Country", "type": "nominal","title":"Country"},
            { "field": "Area", "type": "quantitative","title":"Total Protected Area (km^2)"},
            {"field":"Percentage","type": "quantitative","title":"Land Area Percentage","format":".2f"}
        ]

    }
    },
    {
    "mark": {"type":"circle","color":"green","size":550,"fill":"green"},
    "encoding": {
        "y": { "field": "Country", "type": "nominal" ,"title":null,"sort":{"order":"descending"},"axis":{"labelFontSize":14}},
        "x": { "field": "Area", "type": "quantitative" ,"title":"Total Protected Area (km^2)","axis":{"labelFontSize":14,"titleFontSize":15}},
        "opacity":{"value":1},
        "tooltip":[
            { "field": "Country", "type": "nominal","title":"Country"},
            { "field": "Area", "type": "quantitative","title":"Total Protected Area (km^2)"},
            {"field":"Percentage","type": "quantitative","title":"Land Area Percentage","format":".2f"}
        ]

    }
    }
]
}
