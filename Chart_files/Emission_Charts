            {
            "data": {
                "url":"https://raw.githubusercontent.com/mkoi2/FIT3179Assignment2/main/Data_files/ne_110m_admin_0_countries.topojson",
                "format": {"type": "topojson", "feature": "ne_110m_admin_0_countries"}
            },
            "projection": {"type": "equalEarth"},
            "transform": [
                {
                "calculate": "'Data is not available in ' + datum.properties.NAME",
                "as": "note"
                }
            ],
            "mark": {
                "type": "geoshape",
                "fill": "#ddd",
                "stroke": "white",
                "strokeWidth": 1
            },
            "encoding": {"tooltip": {"field": "note"}}
            },
            {
            "data":{
                "url": "https://raw.githubusercontent.com/mkoi2/FIT3179Assignment2/main/Data_files/GHG_data.csv"
                },
                "transform": [
                    {"filter": "datum.Year == Year_selection"},
                    {
                        "lookup": "Entity",
                        "from":{
                            "data":{
                                "url": "https://raw.githubusercontent.com/mkoi2/FIT3179Assignment2/main/Data_files/ne_110m_admin_0_countries.topojson",
                                "format":{"type": "topojson","feature": "ne_110m_admin_0_countries"}
                            },
                            "key": "properties.NAME"
                        },
                        "as": "geo"
                            
                    }
                    
                ],
                
                "params":[
                    {
                        "name": "Country_Selection",
                        "select":{
                            "type": "point",
                            "fields": ["Entity"],
                            "on": "click",
                            "clear": "dblclick"
                        }
                    }
                ],

                "mark": {"type": "geoshape"},
                "encoding": {
                    "shape":{"field": "geo", "type": "geojson"},
                    "color": {
                        "field": "GHG emissions",
                        "type": "quantitative",
                        "scale": {
                            "type": "linear",
                            "domain": [0,50]
                        }
                    },
                
                
                    "tooltip": [
                        {"field": "Entity", "type": "nominal", "title": "Country"},
                        {"field": "GHG emissions", "type": "quantitative","title": "Greenhouse Gas Emissions (tonnes per person)"},
                        {"field": "Year", "type": "quantitative","title": "Year"}
                    ] 
                }
            }
            ]
            },
            {
                "data":{
                    "url": "https://raw.githubusercontent.com/mkoi2/FIT3179Assignment2/main/Data_files/GHG_100.csv"
                    
                },
                "width": 400,
                "height": 450,
                "title": "Greenhouse Gas Emissions 100 Years Ago vs Now In ",
                "transform": [
                    {"filter": {"param": "Country_Selection"}},
                    {"filter": "Region_Selection == null || datum.Entity == Region_Selection" }
                ],
                "encoding": {
                        "x":{
                            "field": "Year",
                            "type": "quantitative",
                            "title": "Year",
                            "axis":{
                                "values":[1924,2024],
                                "grid": false
                        }},
                        "y":{
                            "field": "GHG emissions",
                             "type": "quantitative", 
                             "title":"Greenhouse Gas Emission (tonnes per person)",
                             "axis":{
                                "grid": false
                             }
                            },
                    "tooltip": [
                        {"field": "Entity", "type": "nominal", "title": "Country"},
