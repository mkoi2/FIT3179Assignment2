{
"$schema": "https://vega.github.io/schema/vega-lite/v5.json",
"title":{ 
    "text":"Average temperature On Earth",
    "font":"Cantata One",
    "fontSize":28,
    "offset":20
},
"width":700,
"height": 450,
"data":{
    "url": "https://raw.githubusercontent.com/mkoi2/FIT3179Assignment2/main/Data_files/temperature-anomaly.csv"
    
},
"layer":[
    {
    "mark": {"type":"line","color":"#f15a23e9","strokeWidth":2},
    "encoding": {
        "x":{"field": "Year","type": "quantitative","title":null,"axis":{"format":"d","tickCount":10,"grid": false,"labelFontSize":14}},
        "y":{
            "field": "Average", 
            "type": "quantitative", 
            "title":"Temperature Change Relative To The Pre-Industrial Period (°C)",
            "axis":{"titleFontSize":15}},
        "tooltip": [
            {"field": "Average", "type": "quantitative", "title": "Change in world temperature (°C)"},
            {"field": "Year", "type": "quantitative","title": "Year"}
        ]
        }
    }
]
}
