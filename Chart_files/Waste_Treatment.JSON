{
"$schema": "https://vega.github.io/schema/vega-lite/v5.json",
"title": { 
    "text": "Waste Treatment Methods By Country",
    "font":"Cantata One",
    "fontSize":28,
    "offset":20 
},
"height":450,
"width":1100,
"data": {
"url": "https://raw.githubusercontent.com/mkoi2/FIT3179Assignment2/main/Data_files/Treatment.csv"
},
"transform":[
    {
        "aggregate": [
            {
                "op":"sum",
                "field":"Amount Treated",
                "as":"Amount"
            }
        ],
        "groupby": [
            "Country",
            "Treatment Method"
        ]
    },
    {
        "joinaggregate": [
            {
                "op": "sum",
                "field": "Amount",
                "as":"Country_Total"
            }
        ],
        "groupby": [
            "Country"
        ]
    },
    {
        "calculate": "datum.Country_Total > 0 ? datum.Amount / datum.Country_Total : 0",
        "as": "MethodShare"
    },
    {
    "window": [
        {
            "op": "row_number",
            "as": "MethodIndex"
        }
    ],
    "groupby": [
        "country"
    ],
    "sort": [
        {"field": "Treatment Method", "order": "ascending"}
    ]
    },
    {
    "window": [
      {
        "op": "row_number",
        "as": "CountryIndex"
      }
    ],
    "sort": [
        {"field": "Country","order":"ascending"},
        {"field": "Treatment Method", "order": "ascending"}
    ]
    },
    {
    "calculate": "datum.CountryIndex - datum.MethodIndex",
    "as": "CountryIndex"
    },
    {
    "calculate": "datum.CountryInex - 1",
    "as": "x0"
    },
    {
    "calculate": "datum.CountryIndex",
    "as": "x1"
    },
    {
    "window": [
      {
        "op": "sum",
        "field": "MethodShare",
        "as": "MethodSum"
      }
    ],
    "groupby": ["Country"],
    "sort": [
        {"field": "Treatment Method", "order": "ascending"}
    ],
    "frame": [null, 0]
  },
  {
    "calculate": "datum.MethodSum - datum.MethodShare",
    "as": "y0"
  },
  {
    "calculate": "datum.MethodSum",
    "as": "y1"
  }
  ],
  "mark": {
        "type": "rect",
        "stroke": "white",
        "strokeWidth": 1
  },
  "encoding": {
        "x": {
            "field": "Country",
            "type": "nominal",
            "sort":"ascending",
            "title":null,
            "axis":{"labelFontSize":14}
        },
        "y": {
            "field": "y0",
            "type": "quantitative",
            "scale": {"domain": [0, 1],"reverse":false},
            "title":null

        },
    "y2": {"field": "y1"},
    "color": {
        "field": "Treatment Method",
        "type": "nominal",
        "title":null,
        "scale":{
            "domain":["Composting","Incineration with energy recovery","Incineration without energy recovery","Landfill","Other disposal","Other recovery","Recycling"],
            "range":["#01665e","#c7eae5","#8c510a","#d8b365","#f6e8c3","#f1a340","#5ab4ac"]
        },
        "legend": {"orient": "top","labelLimit":0}
    },
    "tooltip": [
        {"field": "Country", "type": "nominal"},
        {"field": "Treatment Method", "type": "nominal"},
        {
            "field": "Amount",
            "type": "quantitative",
            "format": ",.0f",
            "title": "Amount Treated"
        },
        {
            "field": "MethodShare",
            "type": "quantitative",
            "format": ".1%",
            "title": "Share Within Country"
        }
    ]
}
}