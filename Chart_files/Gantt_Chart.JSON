        "y":{"datum":"Sustainable development goals","type":"nominal"}
    }
    },
    {
    "mark":{"type": "circle","color":"black"},
    "encoding": {
        "x":{"datum":2015,"type": "quantitative"},
        "y":{"datum":"Sustainable development goals","type":"nominal"}
    }
    },
    {
    "mark":{"type": "text","baseline":"bottom","dy":-25,"text":["In 2015, United Nation","urgued nations to pledge to", "aim for net zero emissions "],"size":8,"align":"left"},
    "encoding": {
        "x":{"datum":2015,"type": "quantitative"},
        "y":{"datum":"Net zero emissions","type":"nominal"}
    }
    },
    {
    "mark":{"type": "circle","color":"black"},
    "encoding": {
