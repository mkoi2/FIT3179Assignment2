{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "description": "A Dorling cartogram",
  "width": 900,
  "height": 450,


  "data": [
    {
      "name": "states",
      "url": "https://raw.githubusercontent.com/mkoi2/FIT3179Assignment2/refs/heads/main/Data_files/AUS_AUST.topojson",
      "format": {"type": "topojson", "feature": "states"}
    },
    {
      "name": "Protected_Areas",
      "url": "https://raw.githubusercontent.com/mkoi2/FIT3179Assignment2/refs/heads/main/Data_files/State_Protection.csv",
      "transform": [
        {
          "type": "lookup",
          "from": "states", "key": "id",
          "fields": ["id"], "as": ["geo"]
        },
        {
          "type": "filter",
          "expr": "datum.geo"
        },
        {
          "type": "formula", "as": "centroid",
          "expr": "geoCentroid('projection', datum.geo)"
        }
      ]
    }
  ],

  "projections": [
    {
      "name": "projection",
      "type": "mercator",
      "scale": 1100,
      "translate": [{"signal": "width / 2"}, {"signal": "height / 2"}]
    }
  ],

  "scales": [
    {
      "name": "size",
      "domain": {"data": "Protected_Areas", "field": "Protected Percentage"},
      "zero": false,
      "range": [1000, 5000]
    },
    {
      "name": "color",
      "type": "linear",
      "nice": true,
      "domain": {"data": "Protected_Areas", "field": "Protected Percentage"},
      "range": "ramp"
    }
  ],

  "legends": [
    {
      "title": "% of each state/territory that is protected",
      "orient": "bottom-right",
      "type": "symbol",
      "size": "size",
      "fill": "color",
      "format": ".1%",
      "clipHeight": 16
    }
  ],

  "marks": [
    {
      "name": "circles",
      "type": "symbol",
      "from": {"data": "Protected_Areas"},
      "encode": {
        "enter": {
          "size": {"scale": "size", "field": "Protected Percentage"},
          "fill": {"scale": "color", "field": "Protected Percentage"},
          "stroke": {"value": "white"},
          "strokeWidth": {"value": 1.5},
          "x": {"field": "centroid[0]"},
          "y": {"field": "centroid[1]"}
        }
      },
      "transform": [
        {
          "type": "force",
          "static": true,
          "forces": [
            {"force": "collide", "radius": {"expr": "1 + sqrt(datum.size) / 2"}},
            {"force": "x", "x": "datum.centroid[0]"},
            {"force": "y", "y": "datum.centroid[1]"}
          ]
        }
      ]
    },
    {
      "type": "text",
      "interactive": false,
      "from": {"data": "circles"},
      "encode": {
        "enter": {
          "align": {"value": "center"},
          "baseline": {"value": "middle"},
          "fontSize": {"value": 13},
          "fontWeight": {"value": "bold"},
          "text": {"field": "Jurisdiction"}
        },
        "update": {
          "x": {"field": "x"},
          "y": {"field": "y"}
        }
      }
    }
  ]
}
