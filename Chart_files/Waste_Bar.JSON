{
"$schema": "https://vega.github.io/schema/vega-lite/v5.json",
"title": { 
    "text": "Waste Generation Of OECD Countries In 2020",
    "font":"Cantata One",
    "fontSize":28,
    "offset":20
},
"width":1100,
"height":300,
"data": {
"url": "https://raw.githubusercontent.com/mkoi2/FIT3179Assignment2/main/Data_files/Waste_Gen.csv"
},
"layer":[{
    "mark": {"type":"bar","color":"#c89e6a","width":20},
        "encoding": {
        "y": { "field": "OBS_VALUE", "type": "quantitative" ,"title":"Waste Generation (Tonnes per Capita)","axis":{"titleFontSize":15}},
        "x": { "field": "Reference area", "type": "nominal" ,"title":null,"axis":null},
        "tooltip":[
            { "field": "Reference area", "type": "nominal","title":"Country"},
            { "field": "OBS_VALUE", "type": "quantitative","title":"Waste Generation (Tonnes per Capita)"}
        ]

    }
    },
    {
    "mark": {"type":"text","color":"saddlebrown","size":15,"angle":270,"align":"left"},
    "encoding": {
        "text":{"field": "Reference area", "type": "nominal"},
        "y": { "datum": 50 , "type": "quantitative" },
        "x": { "field": "Reference area", "type": "nominal" ,"title":null},
        "tooltip":[
            { "field": "Reference area", "type": "nominal","title":"Country"},
            { "field": "OBS_VALUE", "type": "quantitative","title":"Waste Generation (Tonnes per Capita)"}
        ]

    }
    }
]
}
