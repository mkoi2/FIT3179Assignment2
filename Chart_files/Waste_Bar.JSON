{
"$schema": "https://vega.github.io/schema/vega-lite/v5.json",
"title": { "text": "Waste Generation Of OECD Countries In 2020" },
"width":1000,
"height":300,
"data": {
"url": "https://raw.githubusercontent.com/mkoi2/FIT3179Assignment2/main/Data_files/Waste_Gen.csv"
},
"layer":[{
    "mark": {"type":"bar","color":"#aa9251","width":5},
        "encoding": {
        "y": { "field": "OBS_VALUE", "type": "quantitative" ,"title":"Waste Generation (Tonnes per Capita)"},
        "x": { "field": "Reference area", "type": "nominal" ,"title":null},
        "tooltip":[
            { "field": "Reference area", "type": "nominal","title":"Country"},
            { "field": "OBS_VALUE", "type": "quantitative","title":"Waste Generation (Tonnes per Capita)"}
        ]

    }
    },
    {
    "mark": {"type":"circle","color":"#aa9251","size":380,"fill":"aa9251"},
    "encoding": {
        "y": { "field": "OBS_VALUE", "type": "quantitative" ,"title":"Waste Generation (Tonnes per Capita)"},
        "x": { "field": "Reference area", "type": "nominal" ,"title":null},
        "opacity":{"value":1},
        "tooltip":[
            { "field": "Reference area", "type": "nominal","title":"Country"},
            { "field": "OBS_VALUE", "type": "quantitative","title":"Waste Generation (Tonnes per Capita)"}
        ]

    }
    },
    {
    "mark": {"type":"text","color":"black","size":10},
    "encoding": {
        "text":{"field": "OBS_VALUE", "type": "quantitative","format":".0f"},
        "y": { "field": "OBS_VALUE", "type": "quantitative" ,"title":"Waste Generation (Tonnes per Capita)"},
        "x": { "field": "Reference area", "type": "nominal" ,"title":null},
        "tooltip":[
            { "field": "Reference area", "type": "nominal","title":"Country"},
            { "field": "OBS_VALUE", "type": "quantitative","title":"Waste Generation (Tonnes per Capita)"}
        ]

    }
    }
]
}
