{
"$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "params": [
            {
            "name": "Energy_Source",
            "bind": {

                "input": "select",
                "options": [
                    "Total generation",
                    "Fossil",
                    "Renewables",
                    "Wind",
                    "Solar",
                    "Hydro"
                    ],
                "labels": [
                    "Total generation",
                    "Fossil",
                    "Renewables",
                    "Wind",
                    "Solar",
                    "Hydro"
                    ],
                    "name":"Energy source"
                }
            }

    ],

        "title": "Energy Generation Around The World In 2025",
        "width": 900,
        "height": 450,
        "layer": [
            {
            "data": {
                "url":"https://raw.githubusercontent.com/mkoi2/FIT3179Assignment2/main/Data_files/ne_110m_admin_0_countries.topojson",
                "format": {"type": "topojson", "feature": "ne_110m_admin_0_countries"}
            },
            "projection": {"type": "equalEarth"},
            "mark": {
                "type": "geoshape",
                "fill": "#ddd",
                "stroke": "white",
                "strokeWidth": 1
            }
            },
            {
            "data":{
                "url": "https://raw.githubusercontent.com/mkoi2/FIT3179Assignment2/main/Data_files/Gen_energy.csv"
                },
                "transform": [
                    {"filter": "datum.Category == Energy_Source"}  
                ],
                "mark": {"type": "circle"},
                "encoding": {
                    "longitude":{"field":"Longitudinal","type":"quantitative"},
                    "latitude":{"field":"Latitude","type": "quantitative"},
                    "size": {
                        "field": "Energy",
                        "type": "quantitative"
                    },
                    
                    "tooltip": [
                        {"field":"Rank","type": "quantitative","title":"Generation Ranking"},
                        {"field": "Country", "type": "nominal", "title": "Country"},
                        {"field": "Category", "type": "nominal","title":"Energy Source"},
                        {"field": "Energy", "type": "quantitative","title": "Energy generated (Mega watts per person)","format":".2f"}
                    ] 
                }

            },
            {
            "data":{
                "url": "https://raw.githubusercontent.com/mkoi2/FIT3179Assignment2/main/Data_files/Gen_energy.csv"
                },
                "transform": [
                    {"filter": "datum.Category == Energy_Source"}  
                ],
            "mark":{"type": "text","align":"center"},
            "encoding": {
                "longitude":{"field":"Longitudinal","type":"quantitative"},
                "latitude":{"field":"Latitude","type": "quantitative"},
                "text":{"field":"Rank","type": "quantitative"}
            }
            }
        ]

}

