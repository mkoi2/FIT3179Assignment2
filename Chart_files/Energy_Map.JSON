{
"$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "params": [
            {
            "name": "Energy_Source",
            "value":"Total generation",
            "bind": {

                "input": "select",
                "options": [
                    "Total generation",
                    "Fossil",
                    "Renewables",
                    "Wind",
                    "Solar",
                    "Hydro"
                    ],
                "labels": [
                    "Total Generation",
                    "Fossil",
                    "Renewables",
                    "Wind",
                    "Solar",
                    "Hydro"
                    ],
                    "name":"Energy Source "
                }
            }

    ],

        "title": {
            "text":"Energy Generation Around The World In 2025",
            "font":"Cantata One",
            "fontSize":28,
            "offset":20
    },
        "width": 1000,
        "height": 450,
        "layer": [
            {
            "data": {
                "url":"https://raw.githubusercontent.com/mkoi2/FIT3179Assignment2/main/Data_files/ne_110m_admin_0_countries.topojson",
                "format": {"type": "topojson", "feature": "ne_110m_admin_0_countries"}
            },
            "projection": {"type": "equalEarth"},
            "mark": {
                "type": "geoshape",
                "fill": "#d5e1d6",
                "stroke": "darkgray",
                "strokeWidth": 1
            }
            },
            {
            "data":{
                "url": "https://raw.githubusercontent.com/mkoi2/FIT3179Assignment2/main/Data_files/Gen_energy.csv"
                },
                "transform": [
                    {"filter": "datum.Category == Energy_Source"}  
                ],
                "mark": {"type": "circle","color":"yellow","strokeWidth":2,"stroke":"orange"},
                "encoding": {
                    "longitude":{"field":"Longitudinal","type":"quantitative"},
                    "latitude":{"field":"Latitude","type": "quantitative"},
                    "size": {
                        "field": "Energy",
                        "type": "quantitative",
                        "title":"Energy Generated (MWh per Capita)",
                        "legend":{"titleLimit":0},
                        "scale":{"domain":[0,50],"range":[20,2000]}
                    },
                    
                    "tooltip": [
                        {"field":"Rank","type": "quantitative","title":"Ranking"},
                        {"field": "Country", "type": "nominal", "title": "Country"},
                        {"field": "Category", "type": "nominal","title":"Energy Source"},
                        {"field": "Energy", "type": "quantitative","title": "Energy Generated (Mega watts per Capita)","format":".2f"}
                    ] 
                }

            },
            {
            "data":{
                "url": "https://raw.githubusercontent.com/mkoi2/FIT3179Assignment2/main/Data_files/Gen_energy.csv"
                },
                "transform": [
                    {"filter": "datum.Category == Energy_Source"}  
                ],
            "mark":{"type": "text","align":"center"},
            "encoding": {
                "longitude":{"field":"Longitudinal","type":"quantitative"},
                "latitude":{"field":"Latitude","type": "quantitative"},
                "text":{"field":"Rank","type": "quantitative"},
                "tooltip": [
                        {"field":"Rank","type": "quantitative","title":"Ranking"},
                        {"field": "Country", "type": "nominal", "title": "Country"},
                        {"field": "Category", "type": "nominal","title":"Energy Source"},
                        {"field": "Energy", "type": "quantitative","title": "Energy Generated (Mega watts per Capita)","format":".2f"}
                    ] 
            }
            }
        ]

}

