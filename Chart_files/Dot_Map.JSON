{
"$schema": "https://vega.github.io/schema/vega-lite/v5.json",
"width": 1000,
"height": 600,
"title": 
    {
    "text": "Protected Areas of Australia",
    "subtitle": "Terrestrial protected areas by reserve type | Source: CAPAD"
    },
"layer":[
    {
    "data":{
        "url":"https://raw.githubusercontent.com/mkoi2/FIT3179Assignment2/main/Data_files/AUS_AUST.topojson",
        "format": {"type": "topojson", "feature": "AUS_2016_AUST"}
        },
    "projection": {"type":"mercator"},
    "mark":{
                    "type": "geoshape",
                    "fill": "#b4c0b5",
                    "stroke": "white",
                    "strokeWidth": 1
                }
    },
    {
    "data":{
        "url": "https://raw.githubusercontent.com/mkoi2/FIT3179Assignment2/main/Data_files/Protected_Areas.csv"
        },
        "mark": {"type": "circle","color":"green","strokeWidth":2,"stroke":"white"},
        "encoding": {
            "longitude":{"field":"LONGITUDE","type":"quantitative"},
            "latitude":{"field":"LATITUDE","type": "quantitative"},
            
            "tooltip": [
                {"field": "NAME", "type": "nominal","title":"Area Name"},
                {"field": "TYPE", "type": "nominal","title": "Area Type"},
                {"field":"SHAPE_AREA","type": "quantitative","title":"Area Size"}
            ] 
        }

    }
]
}