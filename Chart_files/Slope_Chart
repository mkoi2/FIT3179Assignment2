{
"$schema": "https://vega.github.io/schema/vega-lite/v5.json",
"title": "Average temperature",
"width": "container",
"height": 450,
"data":{
    "url": "https://raw.githubusercontent.com/mkoi2/FIT3179Assignment2/main/Data_files/GHG_data.csv"
    
},

"transform": [
    {"filter": "datum.Year == Year_selection"},
    {
        "lookup": "Entity",
        "from":{
            "data":{
                "url": "https://raw.githubusercontent.com/mkoi2/FIT3179Assignment2/main/Data_files/ne_110m_admin_0_countries.topojson",
                "format":{"type": "topojson","feature": "ne_110m_admin_0_countries"}
            },
            "key": "properties.NAME"
        },
        "as": "geo"
            
    }
],


"mark": "line",
"encoding": {
    "x":{"field": "Year","type": "quantitative","title": "Year"},
    "y":{"field": "Per capita", "type": "quantitative", "title":"Temperature change relative to the pre-industrial period"}
}
}