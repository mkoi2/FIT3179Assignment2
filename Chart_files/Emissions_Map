{
"$schema": "https://vega.github.io/schema/vega-lite/v5.json",
"title": "Greenhouse Gas Emissions Around The World",
"width": 800,
"height": 450,
"projection": {"type": "equalEarth"},
    "params": [
        {
            "name": "Year_selection",
            "value": 2024,
            "bind": {
                "input": "range",
                "min": 1850,
                "max": 2024,
                "step": 1,
                "name": "Year"
            }
        }
    ],

"layer": [
    {
    "data": {
        "url":"https://raw.githubusercontent.com/mkoi2/FIT3179Assignment2/main/Data_files/ne_110m_admin_0_countries.topojson",
        "format": {"type": "topojson", "feature": "ne_110m_admin_0_countries"}
    },
    "transform": [
        {
        "calculate": "'Data is not available in ' + datum.properties.NAME",
        "as": "note"
        }
    ],
    "mark": {
        "type": "geoshape",
        "fill": "#ddd",
        "stroke": "white",
        "strokeWidth": 1
    },
    "encoding": {"tooltip": {"field": "note"}}
    },
    {
    "data":{
        "url": "https://raw.githubusercontent.com/mkoi2/FIT3179Assignment2/main/Data_files/GHG_data.csv"
        },
        "transform": [
            {"filter": "datum.Year == Year_selection"},
            {
                "lookup": "Entity",
                "from":{
                    "data":{
                        "url": "https://raw.githubusercontent.com/mkoi2/FIT3179Assignment2/main/Data_files/ne_110m_admin_0_countries.topojson",
                        "format":{"type": "topojson","feature": "ne_110m_admin_0_countries"}
                    },
                    "key": "properties.NAME"
                },
                "as": "geo"
                    
            }
        ],
        

        "mark": {"type": "geoshape"},
        "encoding": {
            "shape":{"field": "geo", "type": "geojson"},
            "color": {
                "field": "GHG emissionse",
                "type": "quantitative",
                "scale": {"type": "linear"}
            },
        
        
            "tooltip": [
                {"field": "Entity", "type": "nominal", "title": "Country"},
                {"field": "GHG emissions", "type": "quantitative","title": "Greenhouse Gas Emissions Per Capita"},
                {"field": "Year", "type": "quantitative","title": "Year"}
            ]
            
        }
    }
]
}