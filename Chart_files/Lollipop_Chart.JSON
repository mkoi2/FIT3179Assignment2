{
"$schema": "https://vega.github.io/schema/vega-lite/v5.json",
"title": { "text": "Water Withdrawals vs Renewable Freshwater Resources" },
"width":1000,
"height":450,
"data": {
"url": "https://raw.githubusercontent.com/mkoi2/FIT3179Assignment2/main/Data_files/Freshwater_Resources.csv"
},
    "mark": {"type":"bar"},
    "encoding": {
        "y": { "field": "Value", "type": "quantitative" ,"title":"Water Withdrawal (cubic meter per Capita)"},
        "x": { "field": "Entity", "type": "nominal" ,"title":null,"sort":{"order":"descending"}},
        "xOffset":{"field":"Group"},
        "color":{
            "field":"Group",
            "type": "nominal",
            "scale":{
                "domain":["Water withdrawal","Renewable freshwater resources "],
                "range":["#5b90d2","green"]
            }
        },
        
        "tooltip":[
            { "field": "Entity", "type": "nominal","title":"Country"},
            { "field": "Group", "type": "nominal","title":null},
            { "field": "Value", "type": "quantitative","title":"Water (cubic meters)"}
    ]

    }
}

