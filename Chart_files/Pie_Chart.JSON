{
"$schema": "https://vega.github.io/schema/vega-lite/v5.json",
"title": { 
    "text": "Breakdown Of Proteted Areas In Australia",
    "font":"Cantata One",
    "fontSize":28,
    "offset":20
},
"width":500,
"height":300,
"data": {
"url": "https://raw.githubusercontent.com/mkoi2/FIT3179Assignment2/main/Data_files/ICUN_Percentage.csv"
},

    "mark": {"type":"arc","innerRadius":70},
        "encoding": {
        "theta": { "field": "Percentage", "type": "quantitative" ,"title":null},
        "color": { 
            "field": "Category", 
            "type": "nominal",
            "legend":{"orient": "right","labelLimit":0,"labelFontSize":14,"title":null},
            "scale":{
                "domain":[
                    "Ia - Strict Nature Reserve",
                    "Ib - Wilderness Area",
                    "II - National Park",
                    "III - Natural Monument Or Feature",
                    "IV - Habitat/Species Management Area",
                    "V - Protected Landscape Or Seascape",
                    "VI - Protected Area With Sustainable Use Of Natural Resources"],
                "range":["#a6cee3","#33a02c","#c51b8a","#fee08b","#e9a3c9","#66c2a4","#addd8e"]
            }
        },
        "tooltip":[
            { "field": "Category", "type": "nominal","title":"ICUN Category"},
            { "field": "Percentage", "type": "quantitative","title":"Percentage (%)"}
        ]

    }

}