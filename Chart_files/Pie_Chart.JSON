{
"$schema": "https://vega.github.io/schema/vega-lite/v5.json",
"title": { "text": "Breakdown Of Proteted Areas In Australia" },
"width":700,
"height":300,
"data": {
"url": "https://raw.githubusercontent.com/mkoi2/FIT3179Assignment2/main/Data_files/ICUN_Percentage.csv"
},

    "mark": {"type":"arc","innerRadius":50},
        "encoding": {
        "theta": { "field": "Percentage", "type": "quantitative" ,"title":null},
        "color": { 
            "field": "Category", 
            "type": "nominal",
            "legend":{"orient": "right","labelLimit":0}},
        "tooltip":[
            { "field": "Category", "type": "nominal","title":"ICUN Category"},
            { "field": "Percentage", "type": "quantitative","title":null}
        ]

    }
}